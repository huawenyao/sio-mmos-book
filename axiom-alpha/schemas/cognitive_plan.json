{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom-alpha.local/schemas/cognitive_plan.json",
  "title": "CognitivePlan",
  "type": "object",
  "required": [
    "priority_questions",
    "dependency_graph",
    "sufficiency_criteria",
    "exploration_budget"
  ],
  "properties": {
    "priority_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "axiom_dimension",
          "information_value",
          "required_capabilities",
          "estimated_depth",
          "fallback_strategy"
        ],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "axiom_dimension": {
            "type": "string",
            "enum": [
              "stasis_field",
              "flow_dynamics",
              "potential_topology",
              "consensus_state",
              "loop_competition",
              "cross_axiom"
            ]
          },
          "information_value": { "type": "number", "minimum": 0, "maximum": 1 },
          "required_capabilities": {
            "type": "array",
            "items": { "type": "string" }
          },
          "estimated_depth": { "type": "integer", "minimum": 1, "maximum": 5 },
          "fallback_strategy": { "type": "string" }
        }
      }
    },
    "dependency_graph": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "sufficiency_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "exploration_budget": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
