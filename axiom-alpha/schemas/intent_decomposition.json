{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom-alpha.local/schemas/intent_decomposition.json",
  "title": "IntentDecomposition",
  "type": "object",
  "required": [
    "explicit_goal",
    "implicit_needs",
    "decision_context",
    "risk_appetite_signal",
    "cognitive_blind_spots",
    "required_depth",
    "temporal_focus"
  ],
  "properties": {
    "explicit_goal": { "type": "string" },
    "implicit_needs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "decision_context": {
      "type": "string",
      "enum": ["建仓", "加仓", "减仓", "观望", "止损", "复盘", "板块研判", "其他"]
    },
    "risk_appetite_signal": { "type": "string" },
    "cognitive_blind_spots": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_depth": {
      "type": "string",
      "enum": ["快速扫描", "标准研判", "深度研报"]
    },
    "temporal_focus": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 },
      "description": "时间尺度权重，如 L1_微观 / L2_技术 / L3_情绪 / L4_产业 / L5_宏观"
    },
    "target": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["个股", "板块", "指数", "主题", "宏观"] },
        "name": { "type": "string" },
        "ticker": { "type": ["string", "null"] }
      }
    }
  }
}
